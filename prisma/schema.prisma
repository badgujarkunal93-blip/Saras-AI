// Prisma Schema for Saras AI Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Video {
  id               String              @id @default(cuid())
  youtube_video_id String              @unique
  title            String
  channel          String              @default("YouTube Creator")
  duration_seconds Int                 @default(0)
  thumbnail_url    String?
  status           String              @default("processing") // 'processing' | 'ready' | 'failed'
  error_reason     String?
  created_at       DateTime            @default(now())

  segments         Segment[]
  flashcards       Flashcard[]
  progress         UserVideoProgress[]
  tasks            Task[]
  attention_events AttentionEvent[]
  projects         ProjectIdea[]
  notes            SmartNote[]

  @@index([youtube_video_id])
}

model Segment {
  id               String           @id @default(cuid())
  video_id         String
  video            Video            @relation(fields: [video_id], references: [id], onDelete: Cascade)
  order_index      Int
  title            String
  summary          String?
  start_seconds    Int
  end_seconds      Int

  quiz_questions   QuizQuestion[]
  attention_events AttentionEvent[]
  notes            SmartNote[]

  @@index([video_id])
}

model QuizQuestion {
  id             String   @id @default(cuid())
  segment_id     String
  segment        Segment  @relation(fields: [segment_id], references: [id], onDelete: Cascade)
  question       String
  options        String   // JSON string of array of string options: ["A", "B", "C", "D"]
  correct_answer String
  explanation    String?

  @@index([segment_id])
}

model Flashcard {
  id         String   @id @default(cuid())
  video_id   String
  video      Video    @relation(fields: [video_id], references: [id], onDelete: Cascade)
  front      String
  back       String
  mastered   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([video_id])
}

model UserVideoProgress {
  id                    String   @id @default(cuid())
  user_id               String   @default("default_user")
  video_id              String
  video                 Video    @relation(fields: [video_id], references: [id], onDelete: Cascade)
  current_segment_index Int      @default(0)
  completed_segment_ids String   @default("[]") // JSON string array of segment ids
  last_watched_at       DateTime @default(now())

  @@unique([user_id, video_id])
  @@index([video_id])
}

model Task {
  id              String   @id @default(cuid())
  user_id         String   @default("default_user")
  label           String
  done            Boolean  @default(false)
  linked_video_id String?
  linked_video    Video?   @relation(fields: [linked_video_id], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())

  @@index([user_id])
}

model AttentionEvent {
  id         String   @id @default(cuid())
  user_id    String   @default("default_user")
  video_id   String?
  video      Video?   @relation(fields: [video_id], references: [id], onDelete: Cascade)
  segment_id String?
  segment    Segment? @relation(fields: [segment_id], references: [id], onDelete: SetNull)
  event_type String   // 'looked_away' | 'resumed' | 'no_face'
  created_at DateTime @default(now())

  @@index([video_id])
  @@index([user_id])
}

model ChatMessage {
  id                  String   @id @default(cuid())
  user_id             String   @default("default_user")
  role                String   // 'user' | 'assistant'
  content             String
  suggested_video_ids String?  // JSON string array of video ids or youtube metadata
  created_at          DateTime @default(now())

  @@index([user_id])
}

model ProjectIdea {
  id                  String        @id @default(cuid())
  video_id            String
  video               Video         @relation(fields: [video_id], references: [id], onDelete: Cascade)
  title               String
  problem_statement   String
  difficulty          String        @default("Intermediate") // 'Beginner' | 'Intermediate' | 'Advanced'
  why_it_fits         String
  skills_practiced    String        // JSON array of strings
  requirements        String        // JSON array of strings
  milestones          String        // JSON array of objects: [{ "id": "m1", "label": "...", "detail": "..." }]
  expected_outcome    String
  optional_extensions String        @default("[]") // JSON array of strings
  created_at          DateTime      @default(now())
  user_projects       UserProject[]

  @@index([video_id])
}

model UserProject {
  id                      String      @id @default(cuid())
  user_id                 String      @default("default_user")
  project_idea_id         String
  project_idea            ProjectIdea @relation(fields: [project_idea_id], references: [id], onDelete: Cascade)
  status                  String      @default("not_started") // 'not_started' | 'in_progress' | 'completed'
  completed_milestone_ids String      @default("[]") // JSON array of milestone ids
  notes                   String?
  created_at              DateTime    @default(now())
  updated_at              DateTime    @default(now())

  @@unique([user_id, project_idea_id])
  @@index([user_id])
}

model SmartNote {
  id                   String   @id @default(cuid())
  video_id             String
  video                Video    @relation(fields: [video_id], references: [id], onDelete: Cascade)
  segment_id           String?
  segment              Segment? @relation(fields: [segment_id], references: [id], onDelete: SetNull)
  section_type         String   // 'overview' | 'key_concepts' | 'definitions' | 'core_explanations' | 'examples' | 'takeaways' | 'common_mistakes' | 'quick_revision'
  title                String
  content              String   // Formatted study content / explanation
  source_start_seconds Int?
  source_end_seconds   Int?
  order_index          Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())

  @@index([video_id])
  @@index([segment_id])
  @@index([section_type])
}
